# =============================================================================
# Local run: copy to .env and fill API keys only (LLM_PROVIDER=auto by default)
# =============================================================================

LLM_PROVIDER=auto

# Set exactly ONE LLM key (if multiple set: Anthropic → OpenAI → Google → NVIDIA → OpenRouter):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=

# Optional — only if you use that provider (defaults are in config.py)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=gpt-4o-mini
# GOOGLE_MODEL=gemini-2.5-flash
# GOOGLE_MODEL_FALLBACK=gemini-3.5-flash

# Receipt PDF parsing (optional — PyMuPDF fallback if empty)
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io

# Infrastructure (Docker Compose overrides these for the api container)
DATABASE_URL=sqlite:///./storage/northwind.db
WEAVIATE_URL=http://localhost:8080
STORAGE_PATH=./storage
POLICIES_PATH=./policies
SUBMISSIONS_PATH=./submissions

# Policy Q&A embeddings (local CPU — no API key; same for all LLM providers)
# LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Policy Q&A hybrid retrieval (optional overrides)
# POLICY_RAG_TOP_K=5
# POLICY_RAG_SEARCH_MODE=hybrid
# POLICY_RAG_HYBRID_ALPHA=0.5
# POLICY_RAG_MIN_SCORE=0.72
# POLICY_RAG_REFUSE_SCORE=0.45
