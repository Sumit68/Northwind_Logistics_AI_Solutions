      "source_quote": "VP approval means approval from a Grade 9 employee or above."
    },
    {
      "rule_id": "director_approval_grade_7",
      "section": "§3.3",
      "check_type": "grade_role_definition",
      "role": "director",
      "min_grade": 7,
      "violation_status": "compliant",
      "source_quote": "Director approval means approval from a Grade 7 employee or above."
